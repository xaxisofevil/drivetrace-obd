<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is only allowed for the specific ingest-server hosts,
         not globally. Plain HTTP is a real tradeoff for the live-internet
         case (see server/README.md); the bearer token is what actually
         protects the endpoint, not transport encryption, until/unless a
         TLS-terminating reverse proxy is added in front of it. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">ericb.duckdns.org</domain>
    </domain-config>
</network-security-config>
