<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is only allowed for local development targets, not
         globally: the emulator loopback (10.0.2.2), a bare localhost target,
         and nothing else. The production ingest server now terminates real
         TLS (Caddy, DNS-01 via DuckDNS - see docs/SERVER_MIGRATION_PLAN.md),
         so ericb.duckdns.org no longer needs, or gets, a cleartext
         exception; the bearer token travels encrypted end to end. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
