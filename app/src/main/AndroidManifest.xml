<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth: only ever select from already-bonded devices, no scanning -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- GPS: foreground only, requested while a session is active -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Declared, never requested in-app. A session started by AutomationReceiver (MacroDroid,
         car Bluetooth) begins while the app is in the background, and since Android 11 such a
         foreground service has its while-in-use permissions withheld, GPS included, unless the
         user has set Location to "Allow all the time". Declaring it is what makes that option
         exist in Settings at all; the runtime request stays out of SetupScreen's flow, where
         asking for it alongside fine location would make the system reject the whole request.
         See docs/AUTOMATION.md. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service so logging survives screen-off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Best-effort live stream to the home ingest server (see server/) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DriveTrace"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DriveTrace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DriveLoggingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- The automation front door: MacroDroid/Tasker start and stop a drive through this.
             exported="true" is the whole point (another app has to be able to reach it) and is
             also why the receiver checks a locally-generated token before acting on anything;
             see AutomationReceiver.kt and docs/AUTOMATION.md. Android 8+ does not deliver
             implicit broadcasts to manifest receivers, so the sending macro must name the
             package and class explicitly, not just the action. -->
        <receiver
            android:name=".service.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ericbarone.drivetrace.action.AUTOMATION" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
